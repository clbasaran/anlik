    "her gün bir arkadaşına fotoğraf gönderdiğinde bağın büyür. 1 gün ara verirsen bağ devam eder, 2 gün ara verirsen sıfırlanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "your bond grows when you send a photo to a friend every day. if you skip 1 day the bond continues, if you skip 2 days it resets."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "tu vínculo crece cuando le envías una foto a un amigo cada día. si lo dejas 1 día el vínculo continúa, si lo dejas 2 días se reinicia."
          }
        }
      }
    },
