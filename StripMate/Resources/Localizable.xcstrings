        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes usar la funcion de reporte dentro de la app o el correo de arriba para reportar contenido inapropiado. Las solicitudes de retirada se revisan en un maximo de 24 horas."
          }
        }
      }
    },
