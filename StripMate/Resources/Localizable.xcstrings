    "küçük ama tekrar eden anları görünür kılar. bağ, paylaşım ve yakınlık biriktikçe burası da dolmaya başlar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "makes small but recurring moments visible. as bonds, sharing and closeness build up, this place starts to fill too."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "hace visibles los momentos pequeños pero recurrentes. a medida que se acumulan vínculos, momentos compartidos y cercanía, este espacio también empieza a llenarse."
          }
        }
      }
    },
